<?xml version="1.0" encoding="utf-8"?>
<!-- Username entry dialog. Styled to the game's design language:
     parchment panel with gold border, gold corner flourishes
     (original art generated by the patcher - tools/generate_dialog_art.py),
     dark-brown Cinzel text (the closest available match
     for the game's Charlemagne font; the Charlemagne TTF is not in the
     tree), and generated menu-button art for Save / Cancel
     (also tools/generate_dialog_art.py).
     Buttons are full-width stacked strips, like the game's menu items.
     NOTE: the Android system keyboard that appears for the EditText is
     stock and cannot be themed to the game; the dialog itself matches. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_parchment">

    <!-- Gold corner flourishes (atlas art). The source flourish is a
         bottom-left corner ornament; mirrored for the other corners. -->
    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:scaleY="-1"
        android:src="@drawable/flourish_gold" />
    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:scaleX="-1"
        android:scaleY="-1"
        android:src="@drawable/flourish_gold" />
    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|start"
        android:src="@drawable/flourish_gold" />
    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|end"
        android:scaleX="-1"
        android:src="@drawable/flourish_gold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="22dp"
        android:paddingRight="28dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/username_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#3B2A18"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/username_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#3B2A18"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/username_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="#C9A227"
            android:imeOptions="actionDone"
            android:inputType="text|textNoSuggestions"
            android:maxLength="16"
            android:textColor="#3B2A18"
            android:textColorHint="#8A7A55"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/username_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#8B2500"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Save / Cancel. The menu-button art is a 9-patch whose content
             box is only ~5dp tall inside a 48dp button (top+bottom
             padding 21+22 of 112 intrinsic), so a Button using it as its
             own background clips its 16sp label entirely out of view
             (the labels rendered blank on device). The art therefore
             lives on a FrameLayout and the label is a transparent Button
             on top, so the text lays out in the full button height and
             can never be squeezed out by the 9-patch padding again.
             Ids, text, colour and click handling are unchanged, so
             Activity1.cs needs no change. The FrameLayout shows the
             press ripple (addStatesFromChildren) since the transparent
             Button has no background of its own to ripple. Height is
             56dp so the 112dp-intrinsic art is less crushed. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:addStatesFromChildren="true"
            android:background="@drawable/button_bg"
            android:foreground="?android:attr/selectableItemBackground">

            <Button
                android:id="@+id/username_save"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:textColor="#3B2A18"
                android:textSize="16sp" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:addStatesFromChildren="true"
            android:background="@drawable/button_bg"
            android:foreground="?android:attr/selectableItemBackground">

            <Button
                android:id="@+id/username_cancel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:textColor="#3B2A18"
                android:textSize="16sp" />

        </FrameLayout>

    </LinearLayout>
</FrameLayout>
