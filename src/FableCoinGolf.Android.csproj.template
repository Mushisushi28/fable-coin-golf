<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fable: Coin Golf — Android preservation port (MonoGame).
       TEMPLATE: patcher/build.py copies this into your work tree as
       FableCoinGolf.Android.csproj. Set your own ApplicationId below
       (or pass the application-id option to the patcher).

       The decompiled game sources are LINKED from ..\..\decompiled\ —
       that tree is generated on YOUR machine from YOUR OWN XAP and is
       never part of this repository. -->
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>FableCoinGolf.Android</RootNamespace>
    <AssemblyName>FableCoinGolf</AssemblyName>
    <ApplicationId>com.example.fablecoingolf</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.8.10</ApplicationDisplayVersion>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <!-- Standalone adb-installable APK: embed assemblies (no Fast Deployment) -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Adjust if your Android SDK / JDK 17 live elsewhere. -->
    <AndroidSdkDirectory>$(LocalAppData)\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory>C:\Program Files\Java\jdk-17</JavaSdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.2.1105" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game's localisation ResourceManager asks the game assembly for
         "Tech.localisation.fabmob.resources" (the original embedded name).
         The .resx itself comes from YOUR decompiled tree; the patcher
         copies it next to this project file. -->
    <EmbeddedResource Update="Tech.localisation.fabmob.resx" LogicalName="Tech.localisation.fabmob.resources" />
  </ItemGroup>
  <ItemGroup>
    <!-- FabMob: the entry-point Game.cs is replaced by GamePatched.cs,
         which the patcher generates from YOUR decompiled Game.cs
         (patches/files/Game.cs.patch - HD/high-refresh presentation,
         touch/viewport pinning, entry-point fixes). -->
    <Compile Include="..\..\decompiled\FabMob\**\*.cs" Exclude="..\..\decompiled\FabMob\Properties\AssemblyInfo.cs;..\..\decompiled\FabMob\Game.cs" LinkBase="Game\FabMob" />
    <!-- Tech: the files below are replaced by patched copies that the
         patcher generates from YOUR decompiled files into this project
         folder (patches/files/*.patch - coin rendering, text scaling,
         dialogue wrap, menu caps, startup hang, animation timing,
         camera/presentation, and the local cloud backend). Every other
         Tech file compiles from your decompiled tree as-is; four
         leaderboard files are patched in place in your work copy of
         the decompiled tree (they are not excluded). -->
    <Compile Include="..\..\decompiled\Tech\**\*.cs" Exclude="..\..\decompiled\Tech\Properties\AssemblyInfo.cs;..\..\decompiled\Tech\CIwRenderableModel.cs;..\..\decompiled\Tech\CIwRenderableText.cs;..\..\decompiled\Tech\CIwSplashScreens.cs;..\..\decompiled\Tech\CGameOverState.cs;..\..\decompiled\Tech\CIwAnimPlayer.cs;..\..\decompiled\Tech\CCloudConnectivity.cs;..\..\decompiled\Tech\CIwRenderableTextureSpec.cs;..\..\decompiled\Tech\CFabMobGame.cs;..\..\decompiled\Tech\CIwDecoratedText.cs;..\..\decompiled\Tech\CIwCamera.cs;..\..\decompiled\Tech\CIwRenderableTexture.cs" LinkBase="Game\Tech" />
    <Compile Include="..\..\decompiled\ModelData\**\*.cs" Exclude="..\..\decompiled\ModelData\Properties\AssemblyInfo.cs" LinkBase="Game\ModelData" />
    <!-- XBOXLiveConnectivity: the Live wrapper is replaced by the local
         backend in this scaffold (compat/XboxLiveStub.cs). Only its two
         plain data types are compiled from your decompiled originals. -->
    <Compile Include="..\..\decompiled\XBOXLiveConnectivity\CAchievement.cs" LinkBase="Game\XBOXLiveConnectivity" />
    <Compile Include="..\..\decompiled\XBOXLiveConnectivity\CLeaderboardEntry.cs" LinkBase="Game\XBOXLiveConnectivity" />
  </ItemGroup>
</Project>
