 	private TextDisplay m_Text;
 
+	// TRACK-C WS2: runtime text is drawn with SpriteBatch at the font atlas's
+	// native pixel size, while every layout quantity around it (frame pos/size
+	// in pixels) scales with the current viewport. On the 480x800 WP7 viewport
+	// the two spaces coincide; in the 1080x1800 render target they diverge by
+	// 2.25x and text renders small + misaligned. FcgScale() restores the WP7
+	// proportion: it is exactly 1 on a 480-wide viewport (all Update-time
+	// layout, where the scaffold pins the viewport to 480x800) and 2.25 while
+	// rendering into the upscale target.
+	private static float FcgScale()
+	{
+		try
+		{
+			return CIwXnaRenderState.Instance.Graphics.Viewport.Width / 480f;
+		}
+		catch
+		{
+			return 1f;
+		}
+	}
+
