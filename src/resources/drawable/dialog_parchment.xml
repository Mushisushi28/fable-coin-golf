<?xml version="1.0" encoding="utf-8"?>
<!-- Parchment panel for the username dialog. Matches the game's menu panels:
     aged-parchment fill with a thin gold border (same colours sampled from
     the in-game atlas: parchment #F6E4B1, gold #C9A227). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F6E4B1" />
    <stroke android:width="2dp" android:color="#C9A227" />
    <corners android:radius="4dp" />
</shape>
