<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Username dialog theme: the layout draws its own parchment panel,
         so the window itself is transparent with no title bar. -->
    <style name="UsernameDialogTheme" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>
