+	// The username button shows the claimed name ("Username: Bob") or
+	// the "Set Username" label when no name is claimed. The button art
+	// itself is the standard menu_button_template, identical to the
+	// other items on this screen.
+	private void RefreshUsernameButton()
+	{
+		if (m_UsernameEnt == null)
+		{
+			return;
+		}
+		CIwDecoratedText component = m_UsernameEnt.GetComponent<CIwDecoratedText>(2);
+		if (component == null)
+		{
+			return;
+		}
+		if (CLeaderboardService.HasUsername)
+		{
+			component.SetText(string.Format(fabmob.OPTIONS_MENU_USERNAME_SET, CLeaderboardService.Username));
+		}
+		else
+		{
+			component.SetLocalisedStringId("OPTIONS_MENU_USERNAME");
